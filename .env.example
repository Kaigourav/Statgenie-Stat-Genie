# ====================================
# StatGenie Environment Configuration
# ====================================
# Copy this file to .env and fill in your actual values

# ====================================
# REQUIRED SETTINGS
# ====================================

# Google Gemini API Key (REQUIRED)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ====================================
# APPLICATION SETTINGS
# ====================================

# Application mode
DEBUG=true

# Server configuration
HOST=0.0.0.0
PORT=8080

# ====================================
# REDIS CONFIGURATION
# ====================================

# Redis connection (optional - falls back to in-memory if not available)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password
REDIS_SSL=false

# Job time-to-live in seconds (default: 3600 = 1 hour)
JOB_TTL_SECONDS=3600

# ====================================
# FILE UPLOAD SETTINGS
# ====================================

# Maximum file size in MB
MAX_FILE_SIZE_MB=16

# ====================================
# LOGGING CONFIGURATION
# ====================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json or text
# LOG_FORMAT=json

# Optional: Write logs to file
# LOG_FILE=/var/log/statgenie/app.log

# ====================================
# SECURITY SETTINGS (Future Use)
# ====================================

# Enable authentication (not yet implemented)
REQUIRE_AUTH=false

# Enable rate limiting (not yet implemented)
ENABLE_RATE_LIMIT=false
RATE_LIMIT_PER_MINUTE=60

# ====================================
# ADVANCED SETTINGS
# ====================================

# Model selection (optional - uses defaults if not specified)
# GEMINI_PRIMARY_MODEL=gemini-2.0-flash-exp
# GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Feature flags (optional - defaults to enabled)
# ENABLE_FEATURE_ENGINEERING=true
# ENABLE_STATISTICAL_TESTS=true
# ENABLE_AI_INSIGHTS=true
